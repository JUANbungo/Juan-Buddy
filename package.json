{
  "name": "juan-buddy",
  "productName": "Juan Buddy",
  "version": "0.1.33",
  "description": "A cozy 16-bit idle pet RPG \u2014 hatch a mystery egg, evolve your buddy, and take care of it or lose it forever.",
  "main": "main.js",
  "author": "JUANbungo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/generate-icons.js",
    "postinstall": "node scripts/generate-icons.js",
    "test": "node test/engine.test.js && node test/features.test.js && node test/ui.test.js && node test/sprites.test.js && node test/arena.test.js && node test/battle-skills.test.js && node test/home-farm.test.js && node test/reaper.test.js && node test/main.smoke.js",
    "dist": "electron-builder",
    "mobile:prep": "node scripts/prep-mobile.js",
    "mobile:sync": "npm run mobile:prep && npx cap sync android",
    "mobile:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.2",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/local-notifications": "^6.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.juanbungo.juanbuddy",
    "productName": "Juan Buddy",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/icons.js",
      "assets/sprites/**/*",
      "assets/pets/**/*",
      "assets/arena/**/*",
      "assets/battle/**/*",
      "assets/monsters/**/*",
      "assets/death/**/*",
      "assets/items/**/*",
      "assets/ads/**/*",
      "assets/bgm/*.mid",
      "assets/bgm/mp3/*.mp3",
      "assets/icon.png",
      "assets/tray.png",
      "scripts/generate-icons.js",
      "assets/branding/**/*",
      "assets/wallpapers/**/*",
      "assets/scenes/**/*",
      "assets/stardew/**/*",
      "assets/explore_8bit/**/*",
      "assets/sfx/**/*",
      "assets/reaper/**/*",
      "assets/audio/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Game"
    }
  }
}